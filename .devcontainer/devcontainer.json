// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/debian
{
	"name": "Debian",
	"image": "mcr.microsoft.com/devcontainers/base:trixie",

	"features": {
		// Rust with the WebAssembly target for the browser build.
		"ghcr.io/devcontainers/features/rust:1": {
			"targets": "wasm32-unknown-unknown"
		}
	},

	// Trunk builds and serves the web app; lavapipe (mesa-vulkan-drivers) is a software
	// Vulkan driver, so the GPU tests run without a GPU.
	"postCreateCommand": "sudo apt-get update && sudo apt-get install -y mesa-vulkan-drivers && cargo install --locked trunk wasm-bindgen-cli",

	// trunk serve
	"forwardPorts": [8080],

	"customizations": {
		"vscode": {
			"extensions": [
				"anthropic.claude-code",
				"rust-lang.rust-analyzer",
				"PolyMeilex.wgsl"
			]
		}
	}
}
